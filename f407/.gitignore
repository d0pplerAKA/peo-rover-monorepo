# ============================================================
# PEO Rover (STM32F407) - Keil MDK project .gitignore
# ============================================================

# --- Keil build artifacts (Objects/Listings regenerated on every build) ---
Objects/
Listings/
build_cmd.log
*.o
*.axf
*.crf
*.d
*.dep
*.htm
*.lnp
*.lst
*.map
*.iex
*.sct
*.bak

# --- Keil user-specific files (GUI layout / project options, contain local paths) ---
*.uvguix.*
*.uvoptx

# --- VS Code / Keil plugin logs and lock files ---
.vscode/keil-assistant.log
.vscode/uv4.log.lock

# --- Third-party SDK downloads (VL53L0X/VL53L1X API, re-downloadable from vendor) ---
TEMP/

# --- OS junk ---
Thumbs.db
Desktop.ini

# --- Build logs (rewritten by build.bat on every build) ---
build_log.txt
build_vl53.log
